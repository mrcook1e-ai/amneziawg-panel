# Public address clients connect to (required)
WG_HOST=
# Port range for profile pool — one UDP port per profile. awg0=START, awg1=START+1, …
WG_PORT_RANGE_START=51820
WG_PORT_RANGE_END=51859
# Panel HTTP port
PORT=51821
# Bind address for the HTTP server
WEBUI_HOST=0.0.0.0

# Set to enable password protection. Empty = open (do not use in prod).
PASSWORD=

# AmneziaWG interface name and subnet pattern ("x" → host octet)
WG_INTERFACE=awg0
WG_DEFAULT_ADDRESS=10.8.0.x
WG_DEFAULT_DNS=1.1.1.1,1.0.0.1
# Full-tunnel. AmneziaVPN enables client split-tunnel UI only when BOTH are present
# (exact shape "0.0.0.0/0, ::/0"). Do not drop ::/0 just to "fix" IPv6 — the app
# then shows "server does not support split tunneling".
WG_ALLOWED_IPS=0.0.0.0/0, ::/0
# 1280 leaves headroom for AmneziaWG junk/padding over typical 1500 paths.
WG_MTU=1280
WG_PERSISTENT_KEEPALIVE=25

# Where AmneziaWG configs live inside the container
WG_PATH=/etc/amnezia/amneziawg

# Outgoing interface used by MASQUERADE in PostUp
WG_EGRESS_IFACE=

# Obfuscation defaults — H1..H4 are auto-randomized at first start if left as 1..4.
JC=4
JMIN=40
JMAX=70
S1=50
S2=100
H1=1
H2=2
H3=3
H4=4

# Internal: override binary names if needed
AWG_BIN=awg
AWG_QUICK_BIN=awg-quick

# Logging configuration (json | text, debug | info | warn | error)
LOG_FORMAT=json
LOG_LEVEL=info

# Billing and YooKassa. Checkout stays disabled until all three values are set.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# 1 = without VAT. Set this according to the store's tax configuration.
YOOKASSA_VAT_CODE=1
# Public HTTPS origin used for YooKassa return URLs, e.g. https://vpn.example.com
PUBLIC_URL=

# Ручная оплата: короткий контакт, который видит плательщик в кабинете,
# пока не подключена ЮKassa (напр. Telegram @mrcook1e). ЮKassa приоритетнее,
# когда настроена.
PAYMENT_CONTACT=

# Делёж «по трафику»: каждый плательщик платит не меньше этого процента от
# равной доли (0 = чистая пропорция, 100 = поровну). По умолчанию 25.
BILLING_MIN_SHARE_PCT=25
